          "chips": [{ "word": "__proto__", "emote": "a_7tv_kekw", "overlay": false }, { "word": "toString", "emote": "odd_tostr", "overlay": false }] } },
      { "room": "twitch:odd", "stored": { "toString": "a_7tv_kekw" }, "text": "toString __proto__",
