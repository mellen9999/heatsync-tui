  "cases": [
    { "kind": "read", "name": "an emote may be named anything: __proto__, constructor and toString are names like any other", "world": "main", "room": "twitch:odd", "sender": "other", "text": "__proto__ constructor toString hasOwnProperty",
      "expect": [{ "word": "__proto__", "emote": "odd_proto", "from": "room", "overlay": false }, { "word": "constructor", "emote": "odd_ctor", "from": "room", "overlay": false }, { "word": "toString", "emote": "odd_tostr", "from": "room", "overlay": false }] },
    { "kind": "read", "name": "a pick filed under __proto__ is read like any other pick", "world": "main", "room": "twitch:odd", "sender": "other", "text": "__proto__", "refs": { "__proto__": "a_7tv_kekw" },
      "expect": [{ "word": "__proto__", "emote": "a_7tv_kekw", "from": "pick", "overlay": false }] },
    { "kind": "session", "name": "a word named __proto__ ships its ref like any other word", "world": "main", "who": "me", "steps": [
